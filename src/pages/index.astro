---
import Base from "../layouts/Base.astro";
import "../styles/global.css";
---

<Base>
  <section id="hero" class="flex flex-col gap-4">
    <h1 class="text-xl font-bold flex gap-2">
      <div>Hey, there!</div>
      <div>👋</div>
    </h1>
    <blockquote class="text-base opacity-60 border-l-3 border-current/20 pl-4 leading-relaxed">
      And whatever you do in <span class="font-semibold">word</span> or <span class="font-semibold">deed</span>, do all in the name of the <span class="font-bold italic">Lord Jesus</span>, giving thanks to <span class="font-bold italic">God the Father</span> through Him.
      <cite class="block mt-2 text-sm opacity-70">— Colossians 3:17</cite>
    </blockquote>
  </section>
</Base>
