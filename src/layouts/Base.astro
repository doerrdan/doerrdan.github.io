---
interface Props {
  title?: string;
  description?: string;
}

const { title = "doerrdan", description = "Hi! I'm Daniel" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  </head>
  <body>
    <div class="flex items-center space-between w-full flex-col font-medium">
      <main
        class="mx-auto w-full px-12 md:px-0 md:w-2/3 lg:w-1/2 2xl:w-1/3 h-full relative gap-16 py-18 flex flex-col"
      >
        <nav class="flex justify-between">
          <a id="logo" href="/">
            <h2 class="text-2xl font-semibold leading-none">Daniel</h2>
            <h3 class="text-base opacity-50 italic leading-none">doerrdan</h3>
          </a>
          <div id="socials" class="gap-5 flex items-center">
            <a href="https://github.com/doerrdan" aria-label="GitHub">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
              </svg>
            </a>
          </div>
        </nav>

        <slot />
      </main>

      <footer
        class="flex flex-col md:flex-row justify-center gap-4 items-center font-normal text-sm pb-6 opacity-70"
      >
        <p>Made with 🥳 in 2026</p>
        <p class="hidden md:block">•</p>
        <a class="font-bold" href="https://github.com/doerrdan/doerrdan.github.io">Code</a>
      </footer>
    </div>

    <script is:inline src="https://cdn.jsdelivr.net/npm/motion@v12.23.11/dist/motion.js"></script>
    <script is:inline>
      const { animate, stagger } = Motion;

      async function init() {
        await animate(
          "#logo > *, #socials > *, #hero > h1:first-child > *, #hero > blockquote",
          { opacity: [0, 1], y: [20, 0], blur: [1, 0] },
          { delay: stagger(0.05) },
        );

        await animate(
          "footer > *",
          { opacity: [0, 1], y: [20, 0], blur: [1, 0] },
          { delay: stagger(0.15), duration: 0.1 },
        );
      }

      init();
    </script>
  </body>
</html>
